# Copy to .env and adjust. Every value has a working default for local Docker use.

# --- Docker Compose ---
POSTGRES_USER=mydiary
POSTGRES_PASSWORD=mydiary
POSTGRES_DB=mydiary
DB_PORT=5433
SERVER_PORT=3000
CLIENT_PORT=8080

# Signs login tokens. Use a long random value anywhere real.
SECRET_KEY=local-dev-secret-change-me

# Optional: profile picture uploads (PUT /api/v1/user/upload)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Optional: reminder e-mails (Gmail needs an app password)
MAIL_USER=
MAIL_PASSWORD=
