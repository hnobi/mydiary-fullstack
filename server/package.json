{
  "name": "mydiary-server",
  "version": "2.0.0",
  "description": "MyDiary REST API (Express + PostgreSQL)",
  "private": true,
  "type": "module",
  "main": "src/index.js",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "start": "node src/index.js",
    "dev": "node --watch src/index.js",
    "migrate": "node src/models/migrate.js",
    "migrate:reset": "node src/models/migrate.js --reset",
    "test": "NODE_ENV=test mocha --exit --timeout 10000 'test/**/*.test.js'",
    "coverage": "NODE_ENV=test c8 --reporter=text --reporter=html mocha --exit --timeout 10000 'test/**/*.test.js'",
    "lint": "eslint ."
  },
  "author": "Hammed Noibi",
  "license": "ISC",
  "dependencies": {
    "bcryptjs": "^3.0.3",
    "cloudinary": "^2.11.0",
    "cors": "^2.8.6",
    "dotenv": "^18.0.9",
    "express": "^5.3.0",
    "jsonwebtoken": "^9.0.3",
    "multer": "^2.5.0",
    "node-cron": "^4.6.0",
    "nodemailer": "^10.3.1",
    "pg": "^8.23.1",
    "validator": "^13.15.35"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "c8": "^12.0.0",
    "chai": "^6.3.0",
    "eslint": "^10.14.0",
    "globals": "^17.14.0",
    "mocha": "^12.0.3",
    "supertest": "^7.3.2"
  }
}
