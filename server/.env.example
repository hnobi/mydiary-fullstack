# For running the server outside Docker (npm run dev / npm test).
# With `docker compose up db` running, the database is on localhost:5433.
DATABASE_URL=postgres://mydiary:mydiary@localhost:5433/mydiary
TEST_DATABASE_URL=postgres://mydiary:mydiary@localhost:5433/mydiary_test
# Set to true for managed Postgres that requires SSL (AWS RDS, Neon, Render...)
DB_SSL=false
SECRET_KEY=local-dev-secret-change-me
PORT=3000
CLIENT_URL=http://localhost:8080

CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

MAIL_SERVICE=gmail
MAIL_USER=
MAIL_PASSWORD=
